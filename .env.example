# Full project URL (or project ref only — code expands ref to https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key from Supabase Dashboard → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret key for server/admin routes only
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

ADMIN_PASSWORD=your_chosen_password
